# =============================================================================
# .gitignore for a PyTorch / Python ML project
# Covers: Python, Jupyter, PyTorch checkpoints, HuggingFace cache,
#         W&B, virtual envs, secrets, and macOS junk.
# =============================================================================

# --- Python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
pip-wheel-metadata/
MANIFEST

# --- Virtual environments -----------------------------------------------------
.venv/
venv/
env/
.env/
ENV/
env.bak/
venv.bak/
.python-version

# --- Environment / secrets ----------------------------------------------------
.env
.env.*
!.env.example
*.secret
secrets/
credentials/

# --- Jupyter ------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints
profile_default/
ipython_config.py
# Keep notebooks themselves tracked; ignore only checkpoint dirs

# --- PyTorch / model weights --------------------------------------------------
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
checkpoints/
runs/
lightning_logs/

# --- Hugging Face cache -------------------------------------------------------
.cache/
*.arrow
*.json.lock
# Uncomment if you want to ignore HF model downloads entirely:
# models/

# --- Weights & Biases ---------------------------------------------------------
wandb/
artifacts/

# --- Data directories ---------------------------------------------------------
data/raw/
data/processed/
*.csv
*.tsv
*.parquet
*.h5
*.hdf5
*.pkl
*.pickle
# Exception — allow small example data files explicitly if needed:
# !data/examples/*.csv

# --- Logs & outputs -----------------------------------------------------------
logs/
*.log
output/
outputs/
results/
*.out

# --- IDE / editor -------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# --- macOS system files -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
.AppleDB
.AppleDesktop
Network\ Trash\ Folder
Temporary\ Items

# --- Testing & coverage -------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# --- Misc ---------------------------------------------------------------------
*.orig
*.bak
*.tmp
.hypothesis/
